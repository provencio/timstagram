%header.navbar
  .navbar-inner
    = link_to "timstagram", root_path, class: 'wordmark'
    %nav.navbar-links{'aria-label': 'Main'}
      - if user_signed_in?
        = link_to new_post_path, class: 'btn btn-primary' do
          = icon(:plus)
          %span.wide-only New
          Post
        = link_to destroy_user_session_path, method: :delete, class: 'btn btn-quiet', 'aria-label': 'Log out' do
          = icon(:logout)
          %span.wide-only Log out
      - else
        = link_to "Log in", new_user_session_path, class: 'btn btn-quiet'
        = link_to "Sign up", new_user_registration_path, class: 'btn'
