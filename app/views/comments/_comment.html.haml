.comment{id: "comment_#{comment.id}"}
  %p.comment-text
    %span.user-name= comment.user.user_name
    = comment.content
  - if comment.user == current_user
    = link_to post_comment_path(post, comment), method: :delete, data: { confirm: "Delete this comment?" }, remote: true, class: 'delete-comment', 'aria-label': 'Delete comment' do
      = icon(:close)
