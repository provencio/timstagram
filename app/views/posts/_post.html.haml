%article.post{id: "post_#{post.id}"}
  .post-head
    = avatar_for(post.user)
    .post-meta
      %span.user-name= post.user.user_name
      = short_time_ago(post.created_at)
    - if post.user == current_user
      = link_to edit_post_path(post), class: 'btn btn-quiet btn-icon', 'aria-label': 'Edit post' do
        = icon(:edit)
  - if post.image.attached? && post.image.variable?
    = link_to post_path(post), class: 'post-image' do
      = image_tag post.image.variant(:medium), alt: post.caption
  = render 'posts/reactions', post: post
  .post-body
    %p.caption
      %span.user-name= post.user.user_name
      = post.caption
    .comments{id: "comments_#{post.id}"}
      = render post.comments, post: post
  = form_for [post, post.comments.build], html: { class: 'comment-form' } do |f|
    %label
      %span.sr-only Add a comment
      = f.text_field :content, placeholder: 'Add a comment…', class: 'comment-input', id: "comment_content_#{post.id}", autocomplete: 'off'
    %button.btn.btn-icon.comment-submit{type: 'submit', 'aria-label': 'Send comment'}
      = icon(:send)
