.auth
  .auth-brand
    %span.wordmark timstagram
    %p Members only. Photos and memes inside.
  .card
    = simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
      = f.input :email, required: false, autofocus: true, placeholder: 'you@example.com'
      = f.input :password, required: false
      = f.input :remember_me, as: :boolean, label: 'Keep me logged in' if devise_mapping.rememberable?
      = f.button :submit, "Log in", class: 'btn-primary btn-lg btn-block'
  = render "devise/shared/links"
